# npm 10.9.3 revienta resolviendo el peer set de vitest en este proyecto
# ("Cannot read properties of null (reading 'edgesOut')", un bug de arborist).
# Sin esta línea `npm install` y `npm ci` fallan y el deploy se queda sirviendo
# la versión vieja. Con ella, local y CI resuelven igual.
legacy-peer-deps=true
